# Build in rootless Docker with a context containing only pyproject.toml and mineval/.
# Reuse the already-preloaded standalone Codex binaries; never copy host credentials.
FROM mineval-agent:phase3-ready AS codex
FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 update \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 install -y --no-install-recommends \
       bash ca-certificates git python3 python3-venv make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY --from=codex /usr/local/bin/codex /usr/local/bin/codex
COPY --from=codex /usr/local/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host
WORKDIR /opt/mineval
COPY pyproject.toml ./
COPY mineval ./mineval
RUN python3 -m venv /opt/mineval/venv \
    && /opt/mineval/venv/bin/pip install --no-cache-dir . \
    && ln -s /opt/mineval/venv/bin/mineval /usr/local/bin/mineval \
    && node --version && npm --version && python3 --version && codex --version \
    && mineval --help > /dev/null
ENV PYTHON=/usr/bin/python3
LABEL io.mineval.npm-cache="v1"
LABEL io.mineval.dependency-cache="npm,pip"
WORKDIR /workspace
