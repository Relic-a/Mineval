# Local starter for Python/Node historical tasks. Contains no credentials.
# Pin base image digests in your deployment for stronger reproducibility.
FROM node:22.14.0-bookworm-slim
ARG CODEX_VERSION=0.164.0
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv git \
    && rm -rf /var/lib/apt/lists/*
RUN npm install --global @openai/codex@${CODEX_VERSION}
RUN ln -s /usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/bin/codex-code-mode-host /usr/local/bin/codex-code-mode-host
WORKDIR /opt/mineval
COPY pyproject.toml README.md ./
COPY mineval ./mineval
RUN python3 -m venv /opt/mineval-env && /opt/mineval-env/bin/pip install --no-cache-dir .
RUN python3 /opt/mineval/mineval/codex_runner.py --check-runtime
ENV PATH="/opt/mineval-env/bin:${PATH}"
LABEL io.mineval.dependency-cache="pip,npm"
WORKDIR /workspace
