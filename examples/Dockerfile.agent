# Build explicitly; Mineval never builds or pulls images implicitly.
# Review this image and add the historical project's required runtime/dependencies.
FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.163.0
RUN apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 -o Acquire::http::Pipeline-Depth=0 update \
    && apt-get -o Acquire::http::Timeout=30 -o Acquire::Retries=2 -o Acquire::http::Pipeline-Depth=0 install -y --no-install-recommends git python3 ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex@${CODEX_VERSION}
# Credentials, user configuration and projects must never be baked into the image.
WORKDIR /workspace
